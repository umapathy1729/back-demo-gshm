# Copy this to .env and fill in your values
# Never commit .env to version control

# ── API Gateway ────────────────────────────────────────────────────────────────
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# ── All Services ───────────────────────────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALLOWED_ORIGINS=https://your-cloudfront-domain.cloudfront.net

# ── User Service ───────────────────────────────────────────────────────────────
MONGO_URI_USERS=mongodb+srv://user:pass@cluster.mongodb.net/users

# ── Product Service ────────────────────────────────────────────────────────────
MONGO_URI_PRODUCTS=mongodb+srv://user:pass@cluster.mongodb.net/products

# ── Order Service ──────────────────────────────────────────────────────────────
MONGO_URI_ORDERS=mongodb+srv://user:pass@cluster.mongodb.net/orders

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ECS_CLUSTER=mern-cluster
S3_BUCKET=my-mern-frontend
CF_DISTRIBUTION_ID=EXXXXXXXXXXX

# ── Frontend ───────────────────────────────────────────────────────────────────
REACT_APP_API_URL=https://your-alb-dns.elb.amazonaws.com
